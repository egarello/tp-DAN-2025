{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Habitacion",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "ID (autogenerado, omitir en POST)"
    },
    "numero": {
      "type": "integer",
      "minimum": 1,
      "description": "Número de habitación (>= 1)"
    },
    "piso": {
      "type": "integer",
      "minimum": 1,
      "description": "Piso (>= 1)"
    },
    "tipoHabitacion": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" }
      },
      "required": ["id"],
      "description": "Referencia a tipo de habitación (solo enviar id)"
    },
    "hotel": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" }
      },
      "required": ["id"],
      "description": "Referencia a hotel (solo enviar id)"
    }
  },
  "required": ["numero", "piso", "tipoHabitacion", "hotel"],
  "additionalProperties": false
}